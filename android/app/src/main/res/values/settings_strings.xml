    <string name="privacy_photos_title">On-device processing</string>
    <string name="privacy_photos_body">Photos are processed on this device. No account is required and photos are not uploaded. Sharing sends only the images you choose to another app.</string>
    <string name="privacy_access_title">Photo access</string>
    <string name="privacy_access_body">You choose which photos the app can access. Original metadata access reads the original photo file; the app does not request live location access.</string>
    <string name="privacy_metadata_title">Metadata</string>
    <string name="privacy_metadata_body">GPS and device serial numbers are excluded from drafts. Exports omit GPS by default. You can choose whether to keep GPS in export settings.</string>
    <string name="privacy_records_title">Local records</string>
    <string name="privacy_records_body">The library keeps the latest five drafts and five completed export records. Current projects, unfinished tasks, presets, original photos, and saved gallery images are kept.</string>
